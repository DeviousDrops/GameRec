# Copy to .env for local development. .env is gitignored; real secrets go in k8s Secrets.
MINDB_ADDR=127.0.0.1:50051
CORPUS_DIR=data

# Optional. Without it /recommend still works, it just returns no narration.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Object storage (D20). Unset locally: the ingest then runs without the Ingest Lease and says so.
# In the cluster these come from the gamerec-secrets Secret, never from a file in the repo.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Retrieval tuning.
TOP_K=5
MOOD_WEIGHT=0.6
REVIEW_FLOOR=50
