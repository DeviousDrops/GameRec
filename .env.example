# Copy to .env for local development. .env is gitignored; real secrets go in k8s Secrets.
MINDB_ADDR=127.0.0.1:50051
CORPUS_DIR=data

# Optional. Without it /recommend still works, it just returns no narration.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Retrieval tuning.
TOP_K=5
MOOD_WEIGHT=0.6
REVIEW_FLOOR=50
